# Required in production. Use a long unique password for /admin writes.
ADMIN_PASSWORD="change-this-password"

# Required in production for the file-based CMS to commit content changes.
# Use a fine-grained GitHub token scoped only to this repository with Contents: Read and write.
GITHUB_CONTENT_TOKEN="github_pat_or_fine_grained_token"
GITHUB_REPO="brunovoxmusic/aluplexamp"
GITHUB_BRANCH="main"

# Required in production for the contact form.
# CONTACT_FROM_EMAIL must use a sender/domain verified in Resend.
RESEND_API_KEY="re_xxxxxxxxx"
CONTACT_TO_EMAIL="info@aluplex.sk,objednavky@aluplex.sk"
CONTACT_FROM_EMAIL="ALUPLEXamp <noreply@your-verified-domain.com>"
